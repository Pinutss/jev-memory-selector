# Provider: auto | local | mock | custom | jev
# auto = local heuristic, no agent required. Uses JEV + gateway only if both are set.
JEV_PROVIDER=auto

# JEV decision API (required for provider=jev)
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=jev-latest

# User AI gateway, OpenAI-compatible (required for provider=jev)
# Examples: https://openrouter.ai/api/v1  https://api.openai.com/v1
GATEWAY_BASE_URL=https://openrouter.ai/api/v1
GATEWAY_API_KEY=
GATEWAY_MODEL=
# Multi-model provider example: OpenRouter one key, many models
# OPENROUTER_API_KEY=
# Then point GATEWAY_* at the chosen model, or use jev-model-router.

# Selector
JEV_MEMORY_MAX_CANDIDATES=50
JEV_MEMORY_MAX_RESULTS=10
JEV_MEMORY_MAX_TOKENS=4000
JEV_MEMORY_MIN_RELEVANCE=0.15

# Security
JEV_REDACT_SECRETS=true
JEV_MEMORY_AUTH_TOKEN=

# Server
JEV_MEMORY_HOST=127.0.0.1
JEV_MEMORY_PORT=8080
