* text=auto eol=lf

# Linguist : rendre visible la stack réelle (Python, HTML, JS, Docker, YAML).
*.html linguist-detectable=true linguist-language=HTML
*.mjs linguist-detectable=true linguist-language=JavaScript
*.js linguist-detectable=true linguist-language=JavaScript
Dockerfile linguist-detectable=true linguist-language=Dockerfile
*.yml linguist-detectable=true linguist-language=YAML
*.yaml linguist-detectable=true linguist-language=YAML
docker-compose.yml linguist-language=YAML
docs/preview/package-lock.json linguist-generated=true
docs/preview/*.mp4 linguist-generated=true
docs/preview/*.webm linguist-generated=true
docs/preview/*.png linguist-generated=true
docs/vision.md linguist-documentation=true
